# ===== Servidor =====
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://seu-frontend.vercel.app

# ===== Banco de dados (MySQL) =====
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=acaraje_3_irmas

# ===== Autenticação admin =====
JWT_SECRET=troque-por-um-segredo-forte-de-64-caracteres-aleatorios
JWT_EXPIRES_IN=8h

# ===== Loja =====
# Taxa de entrega fixa, em centavos (200 = R$ 2,00).
DELIVERY_FEE_CENTS=200
STORE_CITY=Itamira - BA

# ===== Pix (NUNCA usar prefixo NEXT_PUBLIC_ ou PUBLIC_) =====
# Chave Pix tipo "telefone", no formato aceito pelo Bacen: +55DDDNÚMERO.
PIX_KEY=+5575999036961
PIX_MERCHANT_NAME=ACARAJE 3 IRMAS
PIX_MERCHANT_CITY=Itamira - BA
PIX_MAX_NAME_LEN=25

# ===== WhatsApp para envio do comprovante =====
# Mesmo número usado como chave Pix (formato internacional, só dígitos,
# sem "+", com DDI 55 na frente — é o formato que o link wa.me exige).
WHATSAPP_NUMBER=5575999036961
